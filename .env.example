# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PORT: Optional custom port if 3000 is occupied on external server (Default: 3000)
APP_PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# CLIENT 1: YSSY SOLUÇÕES (yssy-solucoes)
# ==========================================
YSSY_CONTROLLER_URL="https://yssysolucoes-nfr.saas.appdynamics.com"
YSSY_ACCOUNT_NAME="yssysolucoes-nfr"
YSSY_CLIENT_NAME="automator"
YSSY_CLIENT_SECRET="your-client-secret"
YSSY_TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/..."

# ==========================================
# CLIENT 2: LOG-IN LOGISTICA (login-logistica)
# ==========================================
